# 复制为 .env 后按需修改；docker compose 会自动读取
KEY_SERVICE_TOKEN=change-me-please-32bytes-token
KEY_OP_DELAY=0
KEY_DESTROY_DROP_RECEIPT=false
# 清理受阻演练：留空为正常；可设 zero_material/single_file/compacted/
# shredded/restored 让该阶段总是失败，验证不报销毁完成与重启接续
KEY_PURGE_BLOCK_PHASE=
KEY_PURGE_WAIT_SECONDS=10
KEY_PURGE_SCRUB_PASSES=3
MAX_UPLOAD_BYTES=21474836480
UPLOAD_STALE_SECONDS=3600
